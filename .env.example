# Обязательные параметры PostgreSQL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=openverse

# Необязательные: значения по умолчанию совпадают с локальным docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Необязательные параметры приложения.
APP_NAME=OpenVerse Messanger
APP_VERSION=0.1.0
DEBUG=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
DEFAULT_CACHE_LIFETIME=300
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256

WS_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]
MAX_WS_PAYLOAD_BYTES=65536
MAX_CONNECTIONS_PER_USER=5
WS_IDLE_TIMEOUT_SECONDS=60
